{
  "buildCommand": "npm run build",
  "framework": "nuxtjs",
  "installCommand": "npx --yes npm@11.17.0 ci",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://dfkorea-production.up.railway.app/sitemap.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "https://dfkorea-production.up.railway.app/rss.xml"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/tailwind-test",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "env": {
    "NUXT_PUBLIC_SITE_URL": "https://dfkorealed.com",
    "VITE_APP_TITLE": "LED 조명 - 미래를 밝히는 빛"
  }
}

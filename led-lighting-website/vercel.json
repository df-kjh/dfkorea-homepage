{
  "buildCommand": "npm run build",
  "framework": "nuxtjs",
  "installCommand": "npx --yes npm@11.17.0 ci",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://dfkorea-production.up.railway.app/sitemap.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "https://dfkorea-production.up.railway.app/rss.xml"
    }
  ],
  "env": {
    "NUXT_PUBLIC_API_BASE_URL": "https://dfkorea-production.up.railway.app",
    "NUXT_PUBLIC_SITE_URL": "https://www.dfkorealed.com",
    "VITE_API_BASE_URL": "https://dfkorea-production.up.railway.app",
    "VITE_APP_TITLE": "LED 조명 - 미래를 밝히는 빛"
  }
}

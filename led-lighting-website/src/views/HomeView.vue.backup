<template>
  <div class="home">
    <!-- Hero Section -->
    <HeroSection @products-click="navigateTo('/products')" />

    <!-- Features Section -->
    <BaseSection bg-color="white" :custom-style="{ padding: '100px 20px' }">
      <FeatureItem
        ref="feature1Ref"
        :icon="Lightning"
        title="에너지 효율"
        description="최대 80% 전력 절감으로&#10;환경과 비용을 동시에 절약합니다"
        icon-gradient="linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
      />
      <FeatureItem
        ref="feature2Ref"
        :icon="Clock"
        title="긴 수명"
        description="최대 50,000시간 이상&#10;사용 가능한 내구성 있는 제품"
        icon-gradient="linear-gradient(135deg, #f093fb 0%, #f5576c 100%)"
        :reverse="true"
      />
      <FeatureItem
        ref="feature3Ref"
        :icon="Star"
        title="고품질"
        description="엄격한 품질 관리와&#10;국제 인증을 통한 최고 품질 보장"
        icon-gradient="linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)"
      />
    </BaseSection>

    <!-- Products Preview Section -->
    <BaseSection
      ref="productsHeaderRef"
      bg-color="gray"
      title="주요 제품"
      subtitle="다양한 환경에 최적화된 LED 조명 솔루션"
    >
      <div class="products-grid">
        <ProductCard
          v-for="(product, index) in featuredProducts"
          :key="product.id"
          :ref="(el) => setProductRef(el, index)"
          :id="product.id"
          :name="product.name"
          :description="product.description"
          :image="product.image"
          @click="navigateTo('/products')"
        />
      </div>
      <template #footer>
        <div ref="viewAllRef">
          <BaseButton
            type="primary"
            size="large"
            :round="true"
            @click="navigateTo('/products')"
          >
            모든 제품 보기
          </BaseButton>
        </div>
      </template>
    </BaseSection>

    <!-- CTA Section -->
    <CtaSection ref="ctaRef" @cta-click="handleCtaClick" />
  </div>
</template>
          상담 문의하기

<script setup lang="ts">
import { ref, onMounted, onUnmounted, type ComponentPublicInstance } from 'vue'
import { useRouter } from 'vue-router'
import { Lightning, Clock, Star } from '@element-plus/icons-vue'
import { ElMessage } from 'element-plus'

// Components
import HeroSection from '@/components/home/HeroSection.vue'
import FeatureItem from '@/components/home/FeatureItem.vue'
import ProductCard from '@/components/home/ProductCard.vue'
import CtaSection from '@/components/home/CtaSection.vue'
import BaseSection from '@/components/common/BaseSection.vue'
import BaseButton from '@/components/common/BaseButton.vue'

const router = useRouter()

interface Product {
  id: number
  name: string
  description: string
  image: string
}

const featuredProducts: Product[] = [
  {
    id: 1,
    name: 'LED 천장 조명',
    description: '고효율 실내 천장 조명',
    image: 'https://via.placeholder.com/300x200/409EFF/FFFFFF?text=LED+Ceiling+Light',
  },
  {
    id: 2,
    name: 'LED 가로등',
    description: '에너지 절약형 가로등',
    image: 'https://via.placeholder.com/300x200/67C23A/FFFFFF?text=LED+Street+Light',
  },
  {
    id: 3,
    name: 'LED 투광 조명',
    description: '고출력 산업용 조명',
    image: 'https://via.placeholder.com/300x200/E6A23C/FFFFFF?text=LED+Flood+Light',
  },
  {
    id: 4,
    name: 'LED 스마트 조명',
    description: 'IoT 연동 스마트 조명',
    image: 'https://via.placeholder.com/300x200/F56C6C/FFFFFF?text=Smart+LED+Light',
  },
]

const navigateTo = (path: string) => {
  router.push(path)
}

const handleCtaClick = () => {
  ElMessage.success('상담 문의가 접수되었습니다')
}

// Refs for scroll animation
const feature1Ref = ref<InstanceType<typeof FeatureItem> | null>(null)
const feature2Ref = ref<InstanceType<typeof FeatureItem> | null>(null)
const feature3Ref = ref<InstanceType<typeof FeatureItem> | null>(null)
const productsHeaderRef = ref<InstanceType<typeof BaseSection> | null>(null)
const productRefs = ref<(HTMLElement | null)[]>([])
const viewAllRef = ref<HTMLElement | null>(null)
const ctaRef = ref<InstanceType<typeof CtaSection> | null>(null)

const setProductRef = (el: Element | ComponentPublicInstance | null, index: number) => {
  if (el) {
    productRefs.value[index] = el as HTMLElement
  }
}

// Intersection Observer for scroll animations
const observeElement = (element: HTMLElement | null, animationClass: string) => {
  if (!element) return

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add(animationClass)
        }
      })
    },
    {
      threshold: 0.1,
      rootMargin: '0px 0px -100px 0px',
    },
  )

  observer.observe(element)
  return observer
}

const observers: IntersectionObserver[] = []

onMounted(() => {
  // Animate features
  const feature1El = feature1Ref.value?.$el
  const feature2El = feature2Ref.value?.$el
  const feature3El = feature3Ref.value?.$el

  const featureObs1 = observeElement(feature1El, 'fade-in-up')
  const featureObs2 = observeElement(feature2El, 'fade-in-up')
  const featureObs3 = observeElement(feature3El, 'fade-in-up')

  // Animate products header
  const productsHeaderEl = productsHeaderRef.value?.$el
  const productsHeaderObs = observeElement(productsHeaderEl, 'fade-in-up')

  // Animate product cards with delay
  productRefs.value.forEach((ref, index) => {
    if (ref) {
      const obs = observeElement(ref, 'fade-in-up')
      if (obs) observers.push(obs)
      // Add stagger delay
      ref.style.transitionDelay = `${index * 0.1}s`
    }
  })

  // Animate view all button
  const viewAllObs = observeElement(viewAllRef.value, 'fade-in-up')

  // Animate CTA
  const ctaEl = ctaRef.value?.$el
  const ctaObs = observeElement(ctaEl, 'fade-in-up')

  if (featureObs1) observers.push(featureObs1)
  if (featureObs2) observers.push(featureObs2)
  if (featureObs3) observers.push(featureObs3)
  if (productsHeaderObs) observers.push(productsHeaderObs)
  if (viewAllObs) observers.push(viewAllObs)
  if (ctaObs) observers.push(ctaObs)
})

onUnmounted(() => {
  observers.forEach((observer) => observer.disconnect())
})
</script>


# Environment variables template
# Copy this file to .env.development for local development
# For Vercel deployment, set these in Vercel Dashboard > Settings > Environment Variables

# API Base URL
# Development: http://localhost:3000
# Production: https://your-backend-api.com (e.g., https://dfkorea-backend.railway.app)
VITE_API_BASE_URL=http://localhost:3000

# App Title
VITE_APP_TITLE=LED 조명 - 미래를 밝히는 빛

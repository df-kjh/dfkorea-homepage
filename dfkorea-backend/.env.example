# Copy this file to .env.development or .env.production. Keep the copied files
# out of git and inject production values through the hosting platform instead.
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Every tender schedule explicitly uses Asia/Seoul. This value documents the
# deployment expectation; Node's process timezone does not change the jobs.
CRON_TIMEZONE=Asia/Seoul

# Authentication
# Production requires at least 32 characters and at least three of lowercase,
# uppercase, number, and symbol. The historical placeholder is rejected.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# One-off first-admin provisioning only. Inject these temporarily through the
# secret store, run admin:provision:prod(:env), then remove both values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# PostgreSQL. Do not enable synchronize in shared or production databases;
# migrations are the only supported schema change path.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=dfkorea
TYPEORM_SYNCHRONIZE=false

# File upload and optional integrations
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Official tender sources
# Apply at https://www.data.go.kr/ for 나라장터 and K-apt. The public portal can
# display both an encoded and a decoded (raw) service key. Paste the exact
# decoded/raw key when available, or the value designated for direct API use;
# do not URL-encode it yourself because the HTTP client encodes query values once.
PUBLIC_DATA_SERVICE_KEY=
G2B_TENDER_API_BASE_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService
# Optional override only. The application already defaults to this official
# award-service URL; no additional secret or required environment value exists.
# The existing PUBLIC_DATA_SERVICE_KEY needs separate ScsbidInfoService approval.
# G2B_AWARD_API_BASE_URL=https://apis.data.go.kr/1230000/as/ScsbidInfoService
KAPT_TENDER_API_BASE_URL=https://apis.data.go.kr/1613000/ApHusBidPblAncInfoOfferServiceV3

# KEPCO is a LINK API and must stay disabled until the approved OpenAPI manual
# confirms the endpoint, operation, authentication parameter, and response map.
KEPCO_TENDER_ENABLED=false
KEPCO_TENDER_API_BASE_URL=
KEPCO_TENDER_API_KEY=

# NAVER WORKS Mail API over HTTPS. Register this exact redirect URI in the
# Developer Console and grant the `mail` OAuth scope. Client secret and the
# 32-byte base64 encryption key belong only in the deployment secret store.
NAVER_WORKS_API_BASE_URL=https://www.worksapis.com/v1.0
NAVER_WORKS_CLIENT_ID=
NAVER_WORKS_CLIENT_SECRET=
NAVER_WORKS_OAUTH_REDIRECT_URI=https://your-backend.example.com/tenders/mail/oauth/callback
NAVER_WORKS_SENDER_USER_ID=
NAVER_WORKS_FROM_NAME=DF KOREA 입찰정보
NAVER_WORKS_TOKEN_ENCRYPTION_KEY=
NAVER_WORKS_HTTP_TIMEOUT_MS=10000

# 온라인 견적: 기존 DB/JWT/사이트/NAVER WORKS 설정을 재사용합니다.
# 국세청 API 원문(decoded) 서비스 키. 상호 b_nm 포함 진위확인만 사용.
NTS_SERVICE_KEY=
# 별도 QUOTE_* 설정 없이: 주소=CORS_ORIGIN 또는 PUBLIC_SITE_URL,
# IP해시키=JWT_SECRET에서 전용 파생, 견적보유365일, worker=production에서 자동실행.
# 기본값을 바꾸거나 작업자를 잠시 멈출 때만 아래 선택 항목을 사용합니다.
# QUOTE_ALLOWED_ORIGINS=https://example.com
# QUOTE_IP_HASH_SECRET=별도키를_운영할_때만_32자이상
# QUOTE_RETENTION_DAYS=365
# QUOTE_WORKER_ENABLED=false
# 개발환경에서 메일/정리 작업을 시험할 때만 QUOTE_WORKER_ENABLED=true.
# 이전 설정에 QUOTE_WORKER_ENABLED=false가 남아 있으면 운영에서도 실행하지 않습니다.
# 프록시 설정은 자동 추측하지 않습니다. 실제 프록시 hop 수(1~5)를 확인한 경우만 지정.
# TRUST_PROXY_HOPS=1
# 새 견적/payload 마이그레이션을 먼저 적용한 뒤 애플리케이션을 시작합니다.
# 사진은 PostgreSQL 임시 bytea로 보관하며 별도 버킷/로컬파일 설정이 필요 없습니다.

# Environment variables template
# Copy this file to .env.production and .env.development and fill in your values

# Environment
NODE_ENV=

# Server
PORT=
PUBLIC_SITE_URL=
PUBLIC_API_URL=
CRON_TIMEZONE=Asia/Seoul

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=

# CORS
# 허용할 프론트엔드 도메인 (여러 개는 쉼표로 구분)
# Development: http://localhost:5173,http://localhost:5174
# Production: https://your-vercel-app.vercel.app,https://your-domain.com
CORS_ORIGIN=

# File Upload
MAX_FILE_SIZE=
UPLOAD_DEST=

# Database
DB_PATH=

# Google Gemini AI
# 무료 API 키 발급: https://makersuite.google.com/app/apikey
# 또는 https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Cloudflare R2 Storage
# R2 대시보드: https://dash.cloudflare.com → R2
# 1. 버킷 생성
# 2. API 토큰 생성 (Object Read & Write 권한)
# 3. 버킷 Public URL 활성화 (Settings → Public Access)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Official tender data sources
# Apply for the public-data API keys outside this repository. Never commit a key.
PUBLIC_DATA_SERVICE_KEY=
G2B_TENDER_API_BASE_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService
KAPT_TENDER_API_BASE_URL=https://apis.data.go.kr/1613000/ApHusBidPblAncInfoOfferServiceV3

# KEPCO's LINK API remains disabled until its approved OpenAPI manual is recorded.
KEPCO_TENDER_ENABLED=false
KEPCO_TENDER_API_BASE_URL=
KEPCO_TENDER_API_KEY=

# NAVER WORKS SMTP (external app password; never commit a real value)
SMTP_HOST=smtp.worksmobile.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=DF KOREA 입찰정보
